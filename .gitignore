# Python build artifacts and cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Data caches and raw binary files
cache/
.cache/
datasets_cache/
*.h5
*.hdf5
*.pkl
*.npy
*.npz
*.csv
*.parquet

# Whitelist evaluation and replication data (metadata & predictions, ~15MB total)
!data/
!data/catalog/
!data/catalog/*.txt
!data/burst_catalog_parsed.parquet
!data/test_catalog_tags.parquet
!data/flaresense_v2_predictions_test.parquet
!data/meta_*.parquet
!data/retrain/
data/retrain/*smoke*
data/retrain/*backup*
!data/retrain/purged_seed[0-9]_test.parquet
!data/retrain/purged_seed[0-9]_calib.parquet
!data/retrain/purged_seed[0-9]_history.json
!data/retrain/random_control_seed[0-9]_test.parquet
!data/retrain/random_control_seed[0-9]_calib.parquet
!data/retrain/random_control_seed[0-9]_history.json

# Model weights and checkpoints (large binary files)
checkpoints/
*.pt
*.ckpt
*.bin

# Archives & superseded exploratory runs
archive/

# Execution logs
logs/
*.log

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# IDE and OS specific files
.ipynb_checkpoints
.vscode/
.idea/
.DS_Store
Thumbs.db

# Ensure small results, publication figures, and paper package are tracked
!results/*.json
!figures/*.pdf
!figures/*.png
!paper/figures/*.pdf
!paper/figures/*.png
!paper/arxiv_submission.zip
